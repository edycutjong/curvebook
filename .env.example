# Copy to .env (never commit it). Every value is optional except where noted.

# Postgres / Supabase connection string (worker + web). Required.
DATABASE_URL=postgres://curvebook:curvebook@localhost:5433/curvebook

# Solami (https://solami.dev): enables the Yellowstone gRPC stream, Solami RPC and Beam landing.
# Without them the worker runs keyless on public mainnet RPC (logs stream + confirmed-signature crawl).
SOLAMI_RPC_TOKEN=
SOLAMI_SWQOS_KEY=

# Override the JSON-RPC endpoints (comma-separated) and requests/second per endpoint.
RPC_URL=
RPC_RPS=

# Shared secret between the web app (/api/launch/send) and the worker (/beam).
WORKER_TOKEN=
WORKER_URL=http://localhost:8787

# Wallets whose launches are labelled "own" rather than third-party.
OWN_WALLETS=

# Web
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_ROUTER_NETWORK=localnet
