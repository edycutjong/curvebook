# Copy to .env (never commit it). Only DATABASE_URL is required; everything else switches on an upgrade path.

# ── Database ─────────────────────────────────────────────────
# Get from: `docker compose up -d db` (local default below), or https://supabase.com/dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgres://curvebook:curvebook@localhost:5433/curvebook

# ── Yellowstone gRPC stream (optional; e.g. RPC Fast) ─
# Get from: https://rpcfast.com → Dashboard → your plan's gRPC endpoint + x-token. Without GRPC_URL the worker runs keyless on public mainnet RPC.
GRPC_URL=
GRPC_TOKEN=

# ── RPC (optional) ───────────────────────────────────────────
# Get from: any Solana RPC provider (e.g. RPC Fast); comma-separate several to share load
# RPC_URL=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com
# WS_URL=wss://api.mainnet-beta.solana.com
# RPC_RPS=3

# ── Beam landing (optional, off in the live deployment) ──────
# Get from: https://solami.dev → Dashboard → SWQoS (Beam) key
SOLAMI_SWQOS_KEY=

# ── Worker ↔ web ─────────────────────────────────────────────
# Get from: generate one, e.g. `openssl rand -hex 32` — the same value on the worker and the web app
WORKER_TOKEN=
# Get from: wherever the worker runs (docker compose exposes :8787)
WORKER_URL=http://localhost:8787
# Get from: your own wallet addresses (comma-separated); their launches are labelled "own", not third-party
OWN_WALLETS=

# ── Web (public) ─────────────────────────────────────────────
# Get from: the RPC the creator's wallet should use for reads
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Get from: the deployed site URL (used for Open Graph images)
NEXT_PUBLIC_SITE_URL=
# Get from: the public GitHub repository URL
NEXT_PUBLIC_REPO_URL=
# Get from: `scripts/deploy-presets.ts` output; set to mainnet-beta once the router is deployed there
NEXT_PUBLIC_ROUTER_NETWORK=localnet
